<Window x:Class="PhotoChop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        Title="CHOP" Width="1440" Height="900" MinWidth="820" MinHeight="520"
        Background="#191B20" Foreground="#E5E8EE"
        PreviewKeyDown="OnKey" Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <Geometry x:Key="MaskIcon">F0 M 1,3 C 4,2 6,4 10,5 C 14,4 16,2 19,3 L 18,8 C 16,13 13,13 10,9 C 7,13 4,13 2,8 Z M 3.6,6 C 5,4.6 7,5.2 8.5,6.8 C 7,8.3 5,8.2 3.6,6 Z M 11.5,6.8 C 13,5.2 15,4.6 16.4,6 C 15,8.2 13,8.3 11.5,6.8 Z</Geometry>
        <DataTemplate x:Key="LayerRowTemplate">
            <DockPanel Margin="0,1">
                <Button DockPanel.Dock="Left" Click="ToggleRowVisibility" ToolTip="Toggle visibility" Padding="4,1" Margin="0,0,3,0">
                    <Grid Width="16" Height="12">
                        <Path Data="M 1,6 Q 8,-3 15,6 Q 8,15 1,6 Z M 8,3 A 3,3 0 1 1 7.99,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Line X1="1" Y1="1" X2="15" Y2="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Visibility="{Binding HiddenEye}" StrokeThickness="1.5" />
                    </Grid>
                </Button>
                <Button DockPanel.Dock="Right" Click="ToggleRowLock" ToolTip="Toggle lock" Padding="4,1" Margin="3,0,0,0">
                    <TextBlock Text="{Binding LockGlyph}" FontFamily="Segoe MDL2 Assets" />
                </Button>
                <Button DockPanel.Dock="Right" Click="ToggleRowTransforms" ToolTip="{Binding TransformTip}"
                        Padding="4,1" Margin="3,0,0,0" Opacity="{Binding TransformIconOpacity}">
                    <Path Width="14" Height="14" Stretch="Uniform" Data="M 1 1 L 13 1 13 13 1 13 Z M 0 4 L 0 0 4 0 M 10 14 L 14 14 14 10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button DockPanel.Dock="Right" Click="ToggleRowMask" ContextMenuOpening="OpenMaskMenu" ToolTip="Select mask for painting. Alt-click to view only the mask." Padding="4,1"
                        Opacity="{Binding MaskIconOpacity}" BorderBrush="{Binding MaskBorder}" Visibility="{Binding MaskVisibility}"
                        AutomationProperties.Name="Layer mask">
                    <Button.ContextMenu><ContextMenu /></Button.ContextMenu>
                    <Path Width="17" Height="13" Stretch="Uniform" Data="{StaticResource MaskIcon}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button DockPanel.Dock="Left" Click="ToggleRowGroup" ToolTip="Expand or collapse group" Padding="3,1" Margin="{Binding Indent}"
                        Content="{Binding GroupGlyph}" Visibility="{Binding GroupVisibility}" />
                <TextBlock Text="{Binding Layer.Name}" Margin="{Binding NameIndent}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu x:Name="Menus" DockPanel.Dock="Top" />
        <StatusBar DockPanel.Dock="Bottom" Background="#242730">
            <TextBlock x:Name="Status" Foreground="#D4D9E4" Margin="6,2" />
        </StatusBar>
        <Border DockPanel.Dock="Top" Background="#242730" Padding="8,4" Height="40">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ToolOptions" Orientation="Horizontal" VerticalAlignment="Center" />
            </ScrollViewer>
        </Border>
        <dock:DockingManager x:Name="Dock" />
    </DockPanel>
</Window>
